# ============================================================
# GeoLens 本地开发环境配置（示例）
# 复制为 .env 后按需修改。真实 .env 已被 .gitignore 忽略，严禁提交。
# 数据库密码仅用于本地开发（Docker named volume），非生产密码。
# ============================================================

# --- PostgreSQL (Docker) ---
POSTGRES_DB=geolens
POSTGRES_USER=geolens
# 本地开发专用密码，请在 .env 中替换为随机值（可用 powershell 生成）
POSTGRES_PASSWORD=change_me_to_a_random_dev_password
# 宿主端口（默认 5432），仅绑定 127.0.0.1
POSTGRES_PORT=5432

# --- Prisma ---
# 与上面 POSTGRES_* 保持一致
DATABASE_URL=postgresql://geolens:change_me_to_a_random_dev_password@127.0.0.1:5432/geolens?schema=public

# 打印查询日志：DATABASE_LOG=query（可选）
# DATABASE_LOG=query
