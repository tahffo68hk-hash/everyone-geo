// GeoLens - 数据库 Schema（唯一事实来源 Single Source of Truth）
// 所有业务实体统一：id (UUID v4) + createdAt + updatedAt
// ID 决策见 docs/DECISIONS.md D-009；ER 关系/索引/删除策略见 docs/DATABASE.md
// 本 schema 只允许被 packages/database 维护，apps/api 与 apps/worker 通过 @geo/database 访问。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 账号与组织（多租户底座）
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String?
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships OrganizationMember[]

  @@index([status])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique // 租户唯一标识，未来所有业务数据可追溯至此
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]
  monitorTasks MonitorTask[]
  benchmarkRuns BenchmarkRun[]

  // 策略：Organization 为顶层租户实体，删除行为谨慎 —— 存在 Project 时禁止删除（Restrict）。
  // 成员关系随组织级联删除（成员身份从属于组织生命周期）。
}

model OrganizationMember {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  organizationId String  @db.Uuid
  role           OrgRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同一用户不得重复加入同一组织
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================================
// 项目与 GEB 相关实体
// ============================================================

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  description    String?
  industry       String?
  region         String?
  targetAudience String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brands         Brand[]
  competitors    Competitor[]
  querySets      QuerySet[]
  queries        Query[]
  monitorTasks   MonitorTask[]
  benchmarkSuites BenchmarkSuite[]
  benchmarkRuns  BenchmarkRun[]
  competitorCandidates CompetitorCandidate[]
  competitorSets CompetitorSet[]
  reports        BenchmarkReport[]
  diagnosisRuns  DiagnosisRun[]

  // 同一组织内项目名唯一，避免命名冲突
  @@unique([organizationId, name])
  @@index([status])
  // 策略：organizationId FK 由 Prisma 自动建立索引（下同）
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  website     String?
  description String?
  products    String[] // 品牌产品列表，PostgreSQL text[]；决策见 D-010
  aliases     String[] // 用于未来 Mention Detection 的低配品牌别名，如 ["Project Mentor","项目导师","PMentor"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 策略：Brand 从属于 Project，项目删除即删除品牌（级联，理由充分：品牌数据不脱离项目独立存在）
}

model Competitor {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  website     String?
  description String?
  aliases     String[] // 竞对别名，用于 Mention Detection
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 决策：不与 Brand 共用表（业务语义清晰优先），见 D-011
}

model QuerySet {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @db.Uuid
  name        String  // 如：核心推荐词 / 行业问题 / 购买意图 / 品牌比较 / 地域问题
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queries Query[]

  // 同一 Project 内 QuerySet 名称唯一（作为用户可理解的分组标识）
  @@unique([projectId, name])
}

model Query {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  querySetId String?     @db.Uuid
  text       String
  type       QueryType   @default(CUSTOM)
  source     QuerySource @default(MANUAL)
  status     QueryStatus @default(ACTIVE)
  language   String?
  region     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  querySet QuerySet? @relation(fields: [querySetId], references: [id], onDelete: SetNull)
  runs Run[]
  benchmarkQuery BenchmarkQuery?

  @@index([status])
  @@index([type])
  // 策略：querySetId 删除时 SetNull —— Query 保留但脱离分组，避免删除 QuerySet 连带清空监测数据源；
  // 监测结果绝不直接写入 Query 表（未来 Query → MonitorTask → Run → Response 链路）。
}

enum QueryType {
  BRAND
  INDUSTRY
  RECOMMENDATION
  COMPARISON
  PURCHASE_INTENT
  PROBLEM_SOLVING
  LOCAL
  CUSTOM
}

enum QuerySource {
  AI_GENERATED
  MANUAL
  IMPORTED
}

enum QueryStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Mock-only provider registry. Future provider implementations reuse this FK.
model Engine {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique
  name     String
  provider String @default("mock")
  config   Json @default("{}")
  enabled  Boolean @default(true)
  runs     Run[]
  benchmarkRuns BenchmarkRun[]
}

model MonitorTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId      String @db.Uuid
  status         TaskStatus @default(PENDING)
  totalRuns      Int
  completedRuns  Int @default(0)
  failedRuns     Int @default(0)
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  runs           Run[]
  benchmarkRun   BenchmarkRun?
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model Run {
  id             String @id @default(uuid()) @db.Uuid
  monitorTaskId  String @db.Uuid
  queryId        String @db.Uuid
  engineId       String @db.Uuid
  status         RunStatus @default(PENDING)
  attempt        Int @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  executionToken String? @db.Uuid
  // Future Response/Evidence tables will reference Run.id; no fabricated evidence now.
  result         Json?
  analysisStatus AnalysisStatus @default(PENDING)
  analysisAttempts Int @default(0)
  analysisErrorCode String?
  evidence       Evidence?
  candidateLinks CompetitorCandidateEvidence[]
  monitorTask    MonitorTask @relation(fields: [monitorTaskId], references: [id], onDelete: Cascade)
  query          Query @relation(fields: [queryId], references: [id], onDelete: Restrict)
  engine         Engine @relation(fields: [engineId], references: [id], onDelete: Restrict)
  @@unique([monitorTaskId, queryId, engineId])
  @@index([status, createdAt])
  @@index([queryId])
  @@index([engineId])
}

enum RunStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum AnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SourceType {
  official_api
  browser
  third_party_api
  manual
  estimated
  mock
}

enum RetrievalMode {
  api_plain
  api_web_search
  official_web_ui
  browser_agent
  manual_verified
  unknown
}

enum Sentiment {
  positive
  neutral
  negative
  unknown
}

model Evidence {
  id             String @id @default(uuid()) @db.Uuid
  runId          String @unique @db.Uuid
  queryText      String
  rawPrompt      String
  rawResponse    String
  provider       String
  engineKey      String
  engineName     String
  // M6C model identity（Evidence 仍 immutable，见 DB trigger）：
  //   requestedModel = GeoLens 请求 Provider 时指定的模型（deepseek-chat）
  //   responseModel  = Provider 响应中实际声明的模型（deepseek-v4-flash）；未声明则 null
  // 历史证据（M6C 迁移前）：requestedModel 无不可变证明则保持 null；responseModel 仅
  // 在可证明（如 rawProviderPayload 回声或 mock 常量身份）时回填 —— 严禁用当前 Engine
  // 配置猜测历史请求模型。
  requestedModel String?
  responseModel  String?
  // @deprecated legacy（Phase 1 保留兼容，新代码优先读 requestedModel/responseModel）：
  //   model = responseModel ?? requestedModel；modelVersion = Provider 回报的版本/身份。
  model          String
  modelVersion   String?
  retrievalMode  RetrievalMode
  sourceType     SourceType
  metadata       Json
  entitySnapshot Json
  createdAt      DateTime @default(now())
  run            Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  analyses       Analysis[]
  candidateLinks CompetitorCandidateEvidence[]
}

model Analysis {
  id              String @id @default(uuid()) @db.Uuid
  evidenceId      String @db.Uuid
  analysisVersion String
  brandMentioned  Boolean
  mentionPosition Int?
  recommended     Boolean
  sentiment       Sentiment
  // M6B：m6b-competitors-v1 分析记录使用的 Competitor Set（快照语义，非 FK ——
  // 与 BenchmarkRunQuery.benchmarkQueryId 同理：即使未来 Set/Candidate 行被编辑或
  // 删除，历史 Analysis 的解释仍完整自包含；读取路径只信本快照）。
  competitorSetId      String? @db.Uuid
  competitorSetVersion String?
  createdAt       DateTime @default(now())
  evidence        Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  mentions        Mention[]
  citations       Citation[]
  @@unique([evidenceId, analysisVersion])
  @@index([competitorSetId, analysisVersion])
}

model Mention {
  id            String @id @default(uuid()) @db.Uuid
  analysisId    String @db.Uuid
  entityType    String
  entityId      String
  canonicalName String
  displayName   String
  position      Int
  context       String
  sentiment     Sentiment
  startOffset   Int
  endOffset     Int
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@unique([analysisId, entityType, entityId])
}

model Citation {
  id         String @id @default(uuid()) @db.Uuid
  analysisId String @db.Uuid
  url        String
  domain     String
  title      String?
  position   Int
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@unique([analysisId, url])
}

// ============================================================
// M6A - GEO Benchmark（版本化套件 / 查询 / 运行）
// ============================================================
// 设计原则（M6A）：
//   1) BenchmarkSuite 按项目隔离，name+version 版本化 —— 历史 BenchmarkRun
//      记录 suiteName/suiteVersion 快照，未来编辑 Query 不改变历史结果含义。
//   2) BenchmarkQuery 携带自包含 queryText（不依赖项目 Query 文本），执行时通过
//      projectQueryId 镜像到项目 Query 行，复用既有 Run/Evidence/Analysis 管线；
//      Evidence 仍是唯一事实源，不创建第二套 Evidence 系统。
//   3) BenchmarkRun 只做“编排记录”：记录 suite 版本快照 + provider + 它创建的
//      MonitorTask；真实进度/计数以关联 MonitorTask 为准，读取端点实时计算。
//   4) sanity query 用于品牌词控制检查，enabled=false 默认不派发、不计入主指标。

enum BenchmarkSuiteStatus {
  ACTIVE
  RETIRED
}

enum BenchmarkRunType {
  DEMO
  REAL
}

model BenchmarkSuite {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  name        String
  version     String
  description String?
  status      BenchmarkSuiteStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queries BenchmarkQuery[]
  runs    BenchmarkRun[]

  // 同一项目内 suite 名称+版本唯一（可审计的版本化标识）
  @@unique([projectId, name, version])
  @@index([projectId, status])
}

model BenchmarkQuery {
  id             String   @id @default(uuid()) @db.Uuid
  suiteId        String   @db.Uuid
  // 执行镜像：对应项目 Query 行（source=IMPORTED / status=PAUSED，避免污染手动监测 UI）
  projectQueryId String?  @unique @db.Uuid
  queryText      String
  category       String   // kebab 意图类目：tool-discovery / comparison / workflow / recommendation / pain-point / competition
  intent         String   // 人类可读意图说明
  locale         String   @default("zh-CN")
  weight         Float    @default(1)
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  sanity         Boolean  @default(false) // branded sanity query：不计入主要 Visibility Benchmark
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  suite        BenchmarkSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  projectQuery Query?         @relation(fields: [projectQueryId], references: [id], onDelete: SetNull)

  @@unique([suiteId, sortOrder])
  @@index([suiteId, enabled])
}

model BenchmarkRun {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String           @db.Uuid
  suiteId        String           @db.Uuid
  // 版本快照：suite 被编辑/更名不影响历史 Run 的解释
  suiteName      String
  suiteVersion   String
  runType        BenchmarkRunType @default(DEMO)
  provider       String           // engine.provider 快照（mock | deepseek）
  engineId       String           @db.Uuid
  monitorTaskId  String           @unique @db.Uuid
  // 冗余进度镜像（创建时初始化；读取端点以关联 MonitorTask 实时计算为准）
  status         TaskStatus       @default(PENDING)
  plannedRuns    Int
  completedRuns  Int              @default(0)
  failedRuns     Int              @default(0)
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       Json?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite        BenchmarkSuite @relation(fields: [suiteId], references: [id], onDelete: Restrict)
  engine       Engine         @relation(fields: [engineId], references: [id], onDelete: Restrict)
  monitorTask  MonitorTask    @relation(fields: [monitorTaskId], references: [id], onDelete: Restrict)
  runQueries   BenchmarkRunQuery[]
  reports      BenchmarkReport[]

  @@index([projectId, createdAt])
  @@index([suiteId, createdAt])
  @@index([organizationId, createdAt])
}

// Benchmark Run 的查询语义快照：Run 创建瞬间从启用 BenchmarkQuery 行复制
// benchmarkQueryId/projectQueryId/queryText/category/intent/locale/weight/sortOrder/sanity。
// 报告路径（GET /benchmark-runs/:id、/metrics）只读本快照，绝不 live-join 当前
// BenchmarkQuery —— 因此未来编辑 Suite/Query（甚至直接改库）都不会改变历史 Run 的
// 语义与指标；要换语义必须新建 suite 版本（v2），v1 历史保持原样。
model BenchmarkRunQuery {
  id               String  @id @default(uuid()) @db.Uuid
  benchmarkRunId   String  @db.Uuid
  // 来源语义行 / 执行镜像 Query：仅记录（非 FK，归档语义）—— 即使未来源行被删除，
  // 快照仍完整自包含；与 MonitorTask.run.queryId 的关联经 projectQueryId 匹配。
  benchmarkQueryId String  @db.Uuid
  projectQueryId   String  @db.Uuid
  queryText        String
  category         String
  intent           String
  locale           String   @default("zh-CN")
  weight           Float    @default(1)
  sortOrder        Int
  sanity           Boolean  @default(false)

  benchmarkRun BenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@unique([benchmarkRunId, sortOrder])
  @@unique([benchmarkRunId, projectQueryId])
  @@index([benchmarkRunId])
}

// ============================================================
// M6C - Benchmark Report（不可变 GEO 报告快照）+ Model Identity
// ============================================================
// 设计原则（M6C）：
//   1) Report = snapshot：生成瞬间冻结 suite/engine/model identity/analysisVersion/
//      competitorSet/metricsSnapshot 全部 provenance —— 之后任何行被编辑（BenchmarkQuery、
//      Competitor Set、新 Analysis version）都不会改变已生成报告。
//   2) 同一 BenchmarkRun 允许生成多个 Report（如 m4-rule-v1 与 m6b-competitors-v1 各一份），
//      绝不 silently replace 旧报告。
//   3) competitorSetId 为普通 UUID 记录（非 FK，归档语义）：即使 Set 行未来被删除，
//      Report 的 name/version 快照仍自包含。
//   4) requestedModel / responseModel 为运行时的模型身份快照（来自 Evidence 聚合），
//      与 Evidence.model/modelVersion(legacy) 语义分离。
model BenchmarkReport {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  benchmarkRunId   String           @db.Uuid
  // ---- provenance 快照（不可变解释所需）----
  runType          BenchmarkRunType
  suiteName        String
  suiteVersion     String
  provider         String
  engineKey        String
  engineName       String
  requestedModel   String?
  responseModel    String?
  metricSource     String // demo | real | mixed（生成时判定）
  analysisVersion  String
  // ---- Competitor Set 快照（nullable：m4-rule-v1 无竞对集）----
  competitorSetId      String? @db.Uuid
  competitorSetName    String?
  competitorSetVersion String?
  // ---- 完成度快照（PARTIAL 必须可说明成功/失败样本数）----
  completedRuns   Int
  succeededRuns   Int
  failedRuns      Int
  analyzedRuns    Int
  partial         Boolean // true = PARTIAL 语义：报告不代表完整测试集
  metricsSnapshot Json
  metadata        Json     @default("{}")
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  benchmarkRun BenchmarkRun  @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@index([projectId, generatedAt])
  @@index([benchmarkRunId, generatedAt])
  @@index([projectId, analysisVersion])
}

// ============================================================
// M6B - Competitor Discovery（真实竞对发现 / 人工审核 / 版本化竞对集）
// ============================================================
// 设计原则（M6B）：
//   1) 只有 REAL Evidence（sourceType ∈ official_api/browser/third_party_api/manual
//      且 provider ≠ mock）才能进入 Discovery；mock/demo/estimated 一律排除 ——
//      M6A Demo Benchmark Evidence（mock）绝不产生真实竞对输入。
//   2) Mentioned Brand ≠ Competitor：Discovery 只产生 Candidate（DISCOVERED /
//      competitorType=UNKNOWN）；DIRECT/ADJACENT/SUBSTITUTE 只能由人工 Approve 时
//      显式选择，任何代码路径都不得把 UNKNOWN 自动改成 DIRECT。
//   3) CompetitorCandidateEvidence 只存指向性快照（evidenceId/runId/queryText/
//      mentionText/…），不复制整份 Evidence —— Evidence 仍是唯一事实源且不可变。
//   4) CompetitorSet 一旦 ACTIVE 即冻结：Entry 行存 canonicalName/aliases/
//      competitorType/sortOrder 快照（candidateId 为普通 UUID 记录而非 FK），没有
//      任何修改 ACTIVE 集合的端点；要换配置必须新建 name+version 的 DRAFT（v2）。
//   5) A/B/C 为 legacy placeholder：历史 Evidence/Analysis 保持不动；新分析
//      （m6b-competitors-v1）只消费真实候选 + 已激活 Competitor Set。

enum CandidateStatus {
  DISCOVERED
  APPROVED
  REJECTED
}

enum CompetitorType {
  UNKNOWN
  DIRECT
  ADJACENT
  SUBSTITUTE
  NON_COMPETITOR
}

enum CompetitorSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model CompetitorCandidate {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @db.Uuid
  canonicalName String
  normalizedName String // 归并键（NFKC 小写去分隔），discovery/refresh 时按 (projectId, normalizedName) 合并
  aliases       String[] // 观测到的原始变体（大写变体/中英文拼写），供人工编辑
  status        CandidateStatus @default(DISCOVERED)
  competitorType CompetitorType @default(UNKNOWN)
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  // 事实信号计数（仅 Discovery 覆盖的 REAL Evidence；随 refresh 重算，非概率）
  evidenceCount Int @default(0)
  queryCount    Int @default(0)
  mentionCount  Int @default(0)
  recommendationCount Int @default(0)
  metadata      Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceLinks CompetitorCandidateEvidence[]

  @@index([projectId, status])
  @@index([projectId, normalizedName])
  @@index([projectId, updatedAt])
}

// Candidate → Evidence 指向性链接：证据溯源（Candidate → Evidence → Run → rawResponse）。
// 一个 (candidate, evidence) 一条链接；mentionText/position/occurrenceCount 为发现时快照。
model CompetitorCandidateEvidence {
  id            String @id @default(uuid()) @db.Uuid
  candidateId   String @db.Uuid
  evidenceId    String @db.Uuid
  runId         String @db.Uuid
  queryText     String // Evidence.queryText 快照（溯源展示用）
  mentionText   String // 该 Evidence 中首次命中的候选变体文本
  mentionPosition Int // 该候选在该 Evidence 提及中的序号（1-based，与 m4 mention rank 同语义）
  occurrenceCount Int @default(1)
  recommended   Boolean @default(false) // discovery 词法信号（确定性，非概率）
  createdAt     DateTime @default(now())

  candidate CompetitorCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evidence  Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  run       Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([candidateId, evidenceId])
  @@index([evidenceId])
  @@index([runId])
}

model CompetitorSet {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  name        String
  version     String
  status      CompetitorSetStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activatedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries CompetitorSetEntry[]

  // 同一项目内 name+version 唯一（版本化标识；激活后不可变，改名/改配置只能建 v2）
  @@unique([projectId, name, version])
  @@index([projectId, status])
}

// Competitor Set 条目快照：激活瞬间冻结 canonicalName/aliases/competitorType/sortOrder。
// candidateId 为普通 UUID 记录（非 FK，归档语义）—— 后续候选被编辑/拒绝不影响
// 已冻结集合；历史集合语义永不漂移。
model CompetitorSetEntry {
  id            String @id @default(uuid()) @db.Uuid
  competitorSetId String @db.Uuid
  candidateId    String @db.Uuid // 溯源：对应 CompetitorCandidate.id（非 FK）
  canonicalName  String
  aliases        String[]
  competitorType CompetitorType
  sortOrder      Int

  competitorSet CompetitorSet @relation(fields: [competitorSetId], references: [id], onDelete: Cascade)

  @@unique([competitorSetId, sortOrder])
  @@unique([competitorSetId, candidateId])
  @@index([competitorSetId])
}

// ============================================================
// M7A - GEO Diagnosis（可行动的问题诊断，绑定 Report 快照）
// ============================================================
// 设计原则（M7A）：
//   1) Diagnosis 绑定 BenchmarkReport（而非项目实时数据）—— Report 已 snapshot
//      suiteName/Version、provider、requested/responseModel、metricSource、
//      analysisVersion、Competitor Set 版本与 metricsSnapshot；Diagnosis 基于该
//      快照生成，历史语义永不因后续编辑（Query/Set/Analysis v2）漂移。
//   2) 诊断规则为确定性启发式（geolens-diagnosis-v1），阈值属 GeoLens internal
//      heuristic（docs/m7-diagnosis.md 有 disclaimer），绝非行业标准或 LLM 推断。
//   3) DiagnosisFinding 只引用/归档证据链接（evidenceId/runId/queryText 快照），
//      绝不复制 rawPrompt/rawResponse —— Evidence 仍是唯一事实源且不可变。
//   4) findingType 用 String 而非枚举：便于未来 diagnosisVersion 演进扩展类型
//      （与 analysisVersion String 同风格）；severity 用固定枚举（HIGH/MEDIUM/LOW/INFO）。
//   5) 幂等：同一 (reportId, diagnosisVersion, secondaryReportId) 视为同一输入，
//      重复生成返回既有 DiagnosisRun（不无限堆快照）。

enum DiagnosisSeverity {
  HIGH
  MEDIUM
  LOW
  INFO
}

model DiagnosisRun {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  reportId          String   @db.Uuid // 归档引用：Report 已冻结自身 provenance（不级联删除）
  diagnosisVersion  String   // 规则版本：geolens-diagnosis-v1
  secondaryReportId String?  @db.Uuid // Provider Gap 对比的第二份报告（归档引用，可空）
  status            String   @default("READY") // READY = 生成完成（原子）；异常不落半成品
  // 摘要快照：severity 计数 + 代表性问题/竞品/模型差异/数据质量（随 DiagnosisRun 冻结）
  summarySnapshot   Json?
  metadata          Json     @default("{}")
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings DiagnosisFinding[]

  @@index([projectId, generatedAt])
  @@index([reportId, generatedAt])
  // 幂等键（service 层以 null 等价处理 secondaryReportId）
  @@index([reportId, diagnosisVersion, secondaryReportId])
}

model DiagnosisFinding {
  id              String           @id @default(uuid()) @db.Uuid
  diagnosisRunId  String           @db.Uuid
  findingType     String           // LOW_VISIBILITY / CATEGORY_GAP / …（版本演进可扩展）
  severity        DiagnosisSeverity
  category        String?          // canonical category（UI 显示中文）
  title           String
  summary         String           // 事实摘要（含数字）
  explanation     String           // 规则解释 + internal heuristic 说明
  metricName      String?
  currentValue    Float?
  referenceValue  Float?
  queryCount      Int              @default(0) // 受影响测试问题数
  evidenceCount   Int              @default(0)
  provider        String?          // 涉及 Provider（PROVIDER_GAP 等）
  requestedModel  String?
  responseModel   String?
  competitorName  String?          // 涉及竞品 canonicalName
  priorityScore   Int              // 0–100 确定性内部优先级
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())

  diagnosisRun DiagnosisRun             @relation(fields: [diagnosisRunId], references: [id], onDelete: Cascade)
  evidenceLinks DiagnosisFindingEvidence[]

  @@index([diagnosisRunId, severity])
  @@index([diagnosisRunId, findingType])
}

// Finding → Evidence 归档链接（evidenceId/runId 普通 UUID，非 FK —— 只引用不拥有；
// Evidence 删除不影响历史诊断的解释，读取路径以快照 queryText 为准）。
model DiagnosisFindingEvidence {
  id               String @id @default(uuid()) @db.Uuid
  findingId        String @db.Uuid
  evidenceId       String @db.Uuid
  runId            String @db.Uuid
  queryTextSnapshot String // 生成时冻结的问题文本（溯源展示）
  reason           String // 该 Evidence 为何支持此 Finding
  createdAt        DateTime @default(now())

  finding DiagnosisFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([evidenceId])
}
