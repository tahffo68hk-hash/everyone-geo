// GeoLens - 数据库 Schema（唯一事实来源 Single Source of Truth）
// 所有业务实体统一：id (UUID v4) + createdAt + updatedAt
// ID 决策见 docs/DECISIONS.md D-009；ER 关系/索引/删除策略见 docs/DATABASE.md
// 本 schema 只允许被 packages/database 维护，apps/api 与 apps/worker 通过 @geo/database 访问。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 账号与组织（多租户底座）
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String?
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships OrganizationMember[]

  @@index([status])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique // 租户唯一标识，未来所有业务数据可追溯至此
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]
  monitorTasks MonitorTask[]
  benchmarkRuns BenchmarkRun[]

  // —— 内容执行领域（M9/M9A，独立但可追溯）——
  contentDrafts      ContentDraft[]
  contentAssets      ContentAsset[]
  contentPublications Publication[]
  channelConnections ChannelAccountConnection[]
  contentAudits      ContentAuditLog[]
  contentStrategies  ContentStrategy[]
  contentPlanItems   ContentPlanItem[]
  contentCampaigns     ContentCampaign[]
  contentScheduleItems ContentScheduleItem[]

  // 策略：Organization 为顶层租户实体，删除行为谨慎 —— 存在 Project 时禁止删除（Restrict）。
  // 成员关系随组织级联删除（成员身份从属于组织生命周期）。
}

model OrganizationMember {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  organizationId String  @db.Uuid
  role           OrgRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同一用户不得重复加入同一组织
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================================
// 项目与 GEB 相关实体
// ============================================================

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  description    String?
  industry       String?
  region         String?
  targetAudience String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brands         Brand[]
  competitors    Competitor[]
  querySets      QuerySet[]
  queries        Query[]
  monitorTasks   MonitorTask[]
  benchmarkSuites BenchmarkSuite[]
  benchmarkRuns  BenchmarkRun[]
  competitorCandidates CompetitorCandidate[]
  competitorSets CompetitorSet[]
  reports        BenchmarkReport[]
  diagnosisRuns  DiagnosisRun[]
  recommendationRuns RecommendationRun[]
  contentOpportunityRuns ContentOpportunityRun[]
  experiments      OptimizationExperiment[]
  sites            Site[]
  changePlans      OptimizationChangePlan[]

  // —— 内容执行与战略领域（M9/M9A，独立但可追溯）——
  contentDrafts      ContentDraft[]
  contentAssets      ContentAsset[]
  contentPublications Publication[]
  contentStrategies  ContentStrategy[]
  contentPlanItems   ContentPlanItem[]
  contentCampaigns     ContentCampaign[]
  contentScheduleItems ContentScheduleItem[]

  // 同一组织内项目名唯一，避免命名冲突
  @@unique([organizationId, name])
  @@index([status])
  // 策略：organizationId FK 由 Prisma 自动建立索引（下同）
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  website     String?
  description String?
  products    String[] // 品牌产品列表，PostgreSQL text[]；决策见 D-010
  aliases     String[] // 用于未来 Mention Detection 的低配品牌别名，如 ["Project Mentor","项目导师","PMentor"]
  // M8E Target Profile 语义扩展：monitored entity 仍 = project 首个 Brand（worker
  // snapshotEntities 读取），此处只补产品语义字段，不新增第二套 target 数据。
  entityType       String   @default("BRAND") // BRAND / PRODUCT / SERVICE / ORGANIZATION / OTHER
  productCategory  String?  // 如「大学生创新创业 AI 工具」「CRM SaaS」——自由文本，非固定 taxonomy
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliasesDetailed TargetEntityAlias[]
  // 策略：Brand 从属于 Project，项目删除即删除品牌（级联，理由充分：品牌数据不脱离项目独立存在）
}

model Competitor {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  website     String?
  description String?
  aliases     String[] // 竞对别名，用于 Mention Detection
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 决策：不与 Brand 共用表（业务语义清晰优先），见 D-011
}

model QuerySet {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @db.Uuid
  name        String  // 如：核心推荐词 / 行业问题 / 购买意图 / 品牌比较 / 地域问题
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queries Query[]

  // 同一 Project 内 QuerySet 名称唯一（作为用户可理解的分组标识）
  @@unique([projectId, name])
}

model Query {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  querySetId String?     @db.Uuid
  text       String
  type       QueryType   @default(CUSTOM)
  source     QuerySource @default(MANUAL)
  status     QueryStatus @default(ACTIVE)
  language   String?
  region     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  querySet QuerySet? @relation(fields: [querySetId], references: [id], onDelete: SetNull)
  runs Run[]
  benchmarkQuery BenchmarkQuery?

  @@index([status])
  @@index([type])
  // 策略：querySetId 删除时 SetNull —— Query 保留但脱离分组，避免删除 QuerySet 连带清空监测数据源；
  // 监测结果绝不直接写入 Query 表（未来 Query → MonitorTask → Run → Response 链路）。
}

enum QueryType {
  BRAND
  INDUSTRY
  RECOMMENDATION
  COMPARISON
  PURCHASE_INTENT
  PROBLEM_SOLVING
  LOCAL
  CUSTOM
}

enum QuerySource {
  AI_GENERATED
  MANUAL
  IMPORTED
}

enum QueryStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Mock-only provider registry. Future provider implementations reuse this FK.
model Engine {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique
  name     String
  provider String @default("mock")
  config   Json @default("{}")
  enabled  Boolean @default(true)
  runs     Run[]
  benchmarkRuns BenchmarkRun[]
}

model MonitorTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId      String @db.Uuid
  status         TaskStatus @default(PENDING)
  totalRuns      Int
  completedRuns  Int @default(0)
  failedRuns     Int @default(0)
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  runs           Run[]
  benchmarkRun   BenchmarkRun?
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model Run {
  id             String @id @default(uuid()) @db.Uuid
  monitorTaskId  String @db.Uuid
  queryId        String @db.Uuid
  engineId       String @db.Uuid
  status         RunStatus @default(PENDING)
  attempt        Int @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  executionToken String? @db.Uuid
  // Future Response/Evidence tables will reference Run.id; no fabricated evidence now.
  result         Json?
  analysisStatus AnalysisStatus @default(PENDING)
  analysisAttempts Int @default(0)
  analysisErrorCode String?
  evidence       Evidence?
  candidateLinks CompetitorCandidateEvidence[]
  monitorTask    MonitorTask @relation(fields: [monitorTaskId], references: [id], onDelete: Cascade)
  query          Query @relation(fields: [queryId], references: [id], onDelete: Restrict)
  engine         Engine @relation(fields: [engineId], references: [id], onDelete: Restrict)
  @@unique([monitorTaskId, queryId, engineId])
  @@index([status, createdAt])
  @@index([queryId])
  @@index([engineId])
}

enum RunStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  // M8C-R0：人工 Web UI 测量 —— 该 Run 等待用户在官方 AI Web 产品中执行并粘贴回答，
  // 永不进入 worker queue（dispatchPendingRuns 只捞 PENDING/QUEUED）。
  AWAITING_MANUAL_INPUT
  // M8C-R0：用户主动跳过该问题（AI UI 无法回答等）。SKIPPED ≠ 品牌未出现（M7D 语义）。
  SKIPPED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIAL
}

enum AnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SourceType {
  official_api
  browser
  third_party_api
  manual
  estimated
  mock
}

enum RetrievalMode {
  api_plain
  api_web_search
  official_web_ui
  browser_agent
  manual_verified
  unknown
}

enum Sentiment {
  positive
  neutral
  negative
  unknown
}

model Evidence {
  id             String @id @default(uuid()) @db.Uuid
  runId          String @unique @db.Uuid
  queryText      String
  rawPrompt      String
  rawResponse    String
  provider       String
  engineKey      String
  engineName     String
  // M6C model identity（Evidence 仍 immutable，见 DB trigger）：
  //   requestedModel = GeoLens 请求 Provider 时指定的模型（deepseek-chat）
  //   responseModel  = Provider 响应中实际声明的模型（deepseek-v4-flash）；未声明则 null
  // 历史证据（M6C 迁移前）：requestedModel 无不可变证明则保持 null；responseModel 仅
  // 在可证明（如 rawProviderPayload 回声或 mock 常量身份）时回填 —— 严禁用当前 Engine
  // 配置猜测历史请求模型。
  requestedModel String?
  responseModel  String?
  // @deprecated legacy（Phase 1 保留兼容，新代码优先读 requestedModel/responseModel）：
  //   model = responseModel ?? requestedModel；modelVersion = Provider 回报的版本/身份。
  model          String
  modelVersion   String?
  retrievalMode  RetrievalMode
  sourceType     SourceType
  metadata       Json
  entitySnapshot Json
  createdAt      DateTime @default(now())
  run            Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  analyses       Analysis[]
  candidateLinks CompetitorCandidateEvidence[]
}

model Analysis {
  id              String @id @default(uuid()) @db.Uuid
  evidenceId      String @db.Uuid
  analysisVersion String
  brandMentioned  Boolean
  mentionPosition Int?
  recommended     Boolean
  sentiment       Sentiment
  // M6B：m6b-competitors-v1 分析记录使用的 Competitor Set（快照语义，非 FK ——
  // 与 BenchmarkRunQuery.benchmarkQueryId 同理：即使未来 Set/Candidate 行被编辑或
  // 删除，历史 Analysis 的解释仍完整自包含；读取路径只信本快照）。
  competitorSetId      String? @db.Uuid
  competitorSetVersion String?
  createdAt       DateTime @default(now())
  evidence        Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  mentions        Mention[]
  citations       Citation[]
  @@unique([evidenceId, analysisVersion])
  @@index([competitorSetId, analysisVersion])
}

model Mention {
  id            String @id @default(uuid()) @db.Uuid
  analysisId    String @db.Uuid
  entityType    String
  entityId      String
  canonicalName String
  displayName   String
  position      Int
  context       String
  sentiment     Sentiment
  startOffset   Int
  endOffset     Int
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@unique([analysisId, entityType, entityId])
}

model Citation {
  id         String @id @default(uuid()) @db.Uuid
  analysisId String @db.Uuid
  url        String
  domain     String
  title      String?
  position   Int
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@unique([analysisId, url])
}

// ============================================================
// M6A - GEO Benchmark（版本化套件 / 查询 / 运行）
// ============================================================
// 设计原则（M6A）：
//   1) BenchmarkSuite 按项目隔离，name+version 版本化 —— 历史 BenchmarkRun
//      记录 suiteName/suiteVersion 快照，未来编辑 Query 不改变历史结果含义。
//   2) BenchmarkQuery 携带自包含 queryText（不依赖项目 Query 文本），执行时通过
//      projectQueryId 镜像到项目 Query 行，复用既有 Run/Evidence/Analysis 管线；
//      Evidence 仍是唯一事实源，不创建第二套 Evidence 系统。
//   3) BenchmarkRun 只做“编排记录”：记录 suite 版本快照 + provider + 它创建的
//      MonitorTask；真实进度/计数以关联 MonitorTask 为准，读取端点实时计算。
//   4) sanity query 用于品牌词控制检查，enabled=false 默认不派发、不计入主指标。

enum BenchmarkSuiteStatus {
  ACTIVE
  RETIRED
}

enum BenchmarkRunType {
  DEMO
  REAL
}

model BenchmarkSuite {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  name        String
  version     String
  description String?
  status      BenchmarkSuiteStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queries BenchmarkQuery[]
  runs    BenchmarkRun[]

  // 同一项目内 suite 名称+版本唯一（可审计的版本化标识）
  @@unique([projectId, name, version])
  @@index([projectId, status])
}

model BenchmarkQuery {
  id             String   @id @default(uuid()) @db.Uuid
  suiteId        String   @db.Uuid
  // 执行镜像：对应项目 Query 行（source=IMPORTED / status=PAUSED，避免污染手动监测 UI）
  projectQueryId String?  @unique @db.Uuid
  queryText      String
  category       String   // kebab 意图类目：tool-discovery / comparison / workflow / recommendation / pain-point / competition（用户可自定义）
  intent         String   // 人类可读意图说明
  locale         String   @default("zh-CN")
  weight         Float    @default(1)
  enabled        Boolean  @default(true)
  // R2：统一任务中心/Query 运营 —— 软删除归档标记。archive/停用只影响未来执行，
  // 不影响历史 BenchmarkRun/Report/Evidence 快照（保证历史 immutability）。
  archived       Boolean  @default(false)
  sortOrder      Int      @default(0)
  sanity         Boolean  @default(false) // branded sanity query：不计入主要 Visibility Benchmark
  // M8E：queryType 显式语义（DISCOVERY=自然可见度主口径 / BRANDED_SANITY=品牌认知测试，
  // 不计入主 metrics / CUSTOM=用户自定义，含品牌名时警告）。null=历史遗留（按 sanity 兼容解释）。
  queryType      String?  // DISCOVERY / BRANDED_SANITY / CUSTOM / null
  source         String?  // MANUAL / BUILDER / IMPORT / SEED / null
  builderMetadata Json?   // Query Builder provenance（category/scenario/intent/audience/modifier 等组合输入）
  contamination  Json?    // target contamination 检查快照 { status, matchedAlias, checkedTargetVersion }（新建/导入时确定性检查）
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  suite        BenchmarkSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  projectQuery Query?         @relation(fields: [projectQueryId], references: [id], onDelete: SetNull)

  @@unique([suiteId, sortOrder])
  @@index([suiteId, enabled])
}

model BenchmarkRun {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String           @db.Uuid
  suiteId        String           @db.Uuid
  // 版本快照：suite 被编辑/更名不影响历史 Run 的解释
  suiteName      String
  suiteVersion   String
  // M8E：目标实体快照（canonicalName/aliases/entityType/productCategory/website）——
  // 本次测试监测谁。来源：项目 primary Brand（或未来 Target Profile）；在 Run 创建时冻结。
  targetSnapshot Json?
  runType        BenchmarkRunType @default(DEMO)
  provider       String           // engine.provider 快照（mock | deepseek）
  engineId       String           @db.Uuid
  monitorTaskId  String           @unique @db.Uuid
  // 冗余进度镜像（创建时初始化；读取端点以关联 MonitorTask 实时计算为准）
  status         TaskStatus       @default(PENDING)
  plannedRuns    Int
  completedRuns  Int              @default(0)
  failedRuns     Int              @default(0)
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  metadata       Json?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite        BenchmarkSuite @relation(fields: [suiteId], references: [id], onDelete: Restrict)
  engine       Engine         @relation(fields: [engineId], references: [id], onDelete: Restrict)
  monitorTask  MonitorTask    @relation(fields: [monitorTaskId], references: [id], onDelete: Restrict)
  runQueries   BenchmarkRunQuery[]
  reports      BenchmarkReport[]

  @@index([projectId, createdAt])
  @@index([suiteId, createdAt])
  @@index([organizationId, createdAt])
}

// Benchmark Run 的查询语义快照：Run 创建瞬间从启用 BenchmarkQuery 行复制
// benchmarkQueryId/projectQueryId/queryText/category/intent/locale/weight/sortOrder/sanity。
// 报告路径（GET /benchmark-runs/:id、/metrics）只读本快照，绝不 live-join 当前
// BenchmarkQuery —— 因此未来编辑 Suite/Query（甚至直接改库）都不会改变历史 Run 的
// 语义与指标；要换语义必须新建 suite 版本（v2），v1 历史保持原样。
model BenchmarkRunQuery {
  id               String  @id @default(uuid()) @db.Uuid
  benchmarkRunId   String  @db.Uuid
  // 来源语义行 / 执行镜像 Query：仅记录（非 FK，归档语义）—— 即使未来源行被删除，
  // 快照仍完整自包含；与 MonitorTask.run.queryId 的关联经 projectQueryId 匹配。
  benchmarkQueryId String  @db.Uuid
  projectQueryId   String  @db.Uuid
  queryText        String
  category         String
  intent           String
  locale           String   @default("zh-CN")
  weight           Float    @default(1)
  sortOrder        Int
  sanity           Boolean  @default(false)
  // M8E：queryType 快照（DISCOVERY/BRANDED_SANITY/CUSTOM；null=历史遗留按 sanity 解释）。
  // 运行后源行 queryType 被改不影响本快照（与 sanity 语义一致）。
  queryType        String?
  // M8E：目标污染检查快照（保存时确定性检查；DISCOVERY 且含目标 → 应被拒，记录留档）
  contamination    Json?

  benchmarkRun BenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@unique([benchmarkRunId, sortOrder])
  @@unique([benchmarkRunId, projectQueryId])
  @@index([benchmarkRunId])
}

// ============================================================
// M6C - Benchmark Report（不可变 GEO 报告快照）+ Model Identity
// ============================================================
// 设计原则（M6C）：
//   1) Report = snapshot：生成瞬间冻结 suite/engine/model identity/analysisVersion/
//      competitorSet/metricsSnapshot 全部 provenance —— 之后任何行被编辑（BenchmarkQuery、
//      Competitor Set、新 Analysis version）都不会改变已生成报告。
//   2) 同一 BenchmarkRun 允许生成多个 Report（如 m4-rule-v1 与 m6b-competitors-v1 各一份），
//      绝不 silently replace 旧报告。
//   3) competitorSetId 为普通 UUID 记录（非 FK，归档语义）：即使 Set 行未来被删除，
//      Report 的 name/version 快照仍自包含。
//   4) requestedModel / responseModel 为运行时的模型身份快照（来自 Evidence 聚合），
//      与 Evidence.model/modelVersion(legacy) 语义分离。
model BenchmarkReport {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @db.Uuid
  benchmarkRunId   String           @db.Uuid
  // ---- provenance 快照（不可变解释所需）----
  runType          BenchmarkRunType
  suiteName        String
  suiteVersion     String
  provider         String
  engineKey        String
  engineName       String
  requestedModel   String?
  responseModel    String?
  metricSource     String // demo | real | mixed（生成时判定）
  analysisVersion  String
  // ---- Competitor Set 快照（nullable：m4-rule-v1 无竞对集）----
  competitorSetId      String? @db.Uuid
  competitorSetName    String?
  competitorSetVersion String?
  // ---- 完成度快照（PARTIAL 必须可说明成功/失败样本数）----
  completedRuns   Int
  succeededRuns   Int
  failedRuns      Int
  analyzedRuns    Int
  partial         Boolean // true = PARTIAL 语义：报告不代表完整测试集
  metricsSnapshot Json
  metadata        Json     @default("{}")
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  benchmarkRun BenchmarkRun  @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  @@index([projectId, generatedAt])
  @@index([benchmarkRunId, generatedAt])
  @@index([projectId, analysisVersion])
}

// ============================================================
// M6B - Competitor Discovery（真实竞对发现 / 人工审核 / 版本化竞对集）
// ============================================================
// 设计原则（M6B）：
//   1) 只有 REAL Evidence（sourceType ∈ official_api/browser/third_party_api/manual
//      且 provider ≠ mock）才能进入 Discovery；mock/demo/estimated 一律排除 ——
//      M6A Demo Benchmark Evidence（mock）绝不产生真实竞对输入。
//   2) Mentioned Brand ≠ Competitor：Discovery 只产生 Candidate（DISCOVERED /
//      competitorType=UNKNOWN）；DIRECT/ADJACENT/SUBSTITUTE 只能由人工 Approve 时
//      显式选择，任何代码路径都不得把 UNKNOWN 自动改成 DIRECT。
//   3) CompetitorCandidateEvidence 只存指向性快照（evidenceId/runId/queryText/
//      mentionText/…），不复制整份 Evidence —— Evidence 仍是唯一事实源且不可变。
//   4) CompetitorSet 一旦 ACTIVE 即冻结：Entry 行存 canonicalName/aliases/
//      competitorType/sortOrder 快照（candidateId 为普通 UUID 记录而非 FK），没有
//      任何修改 ACTIVE 集合的端点；要换配置必须新建 name+version 的 DRAFT（v2）。
//   5) A/B/C 为 legacy placeholder：历史 Evidence/Analysis 保持不动；新分析
//      （m6b-competitors-v1）只消费真实候选 + 已激活 Competitor Set。

enum CandidateStatus {
  DISCOVERED
  APPROVED
  REJECTED
}

enum CompetitorType {
  UNKNOWN
  DIRECT
  ADJACENT
  SUBSTITUTE
  NON_COMPETITOR
}

enum CompetitorSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model CompetitorCandidate {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @db.Uuid
  canonicalName String
  normalizedName String // 归并键（NFKC 小写去分隔），discovery/refresh 时按 (projectId, normalizedName) 合并
  aliases       String[] // 观测到的原始变体（大写变体/中英文拼写），供人工编辑
  status        CandidateStatus @default(DISCOVERED)
  competitorType CompetitorType @default(UNKNOWN)
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  // 事实信号计数（仅 Discovery 覆盖的 REAL Evidence；随 refresh 重算，非概率）
  evidenceCount Int @default(0)
  queryCount    Int @default(0)
  mentionCount  Int @default(0)
  recommendationCount Int @default(0)
  metadata      Json @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceLinks CompetitorCandidateEvidence[]

  @@index([projectId, status])
  @@index([projectId, normalizedName])
  @@index([projectId, updatedAt])
}

// Candidate → Evidence 指向性链接：证据溯源（Candidate → Evidence → Run → rawResponse）。
// 一个 (candidate, evidence) 一条链接；mentionText/position/occurrenceCount 为发现时快照。
model CompetitorCandidateEvidence {
  id            String @id @default(uuid()) @db.Uuid
  candidateId   String @db.Uuid
  evidenceId    String @db.Uuid
  runId         String @db.Uuid
  queryText     String // Evidence.queryText 快照（溯源展示用）
  mentionText   String // 该 Evidence 中首次命中的候选变体文本
  mentionPosition Int // 该候选在该 Evidence 提及中的序号（1-based，与 m4 mention rank 同语义）
  occurrenceCount Int @default(1)
  recommended   Boolean @default(false) // discovery 词法信号（确定性，非概率）
  createdAt     DateTime @default(now())

  candidate CompetitorCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evidence  Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  run       Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([candidateId, evidenceId])
  @@index([evidenceId])
  @@index([runId])
}

model CompetitorSet {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  name        String
  version     String
  status      CompetitorSetStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activatedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entries CompetitorSetEntry[]

  // 同一项目内 name+version 唯一（版本化标识；激活后不可变，改名/改配置只能建 v2）
  @@unique([projectId, name, version])
  @@index([projectId, status])
}

// Competitor Set 条目快照：激活瞬间冻结 canonicalName/aliases/competitorType/sortOrder。
// candidateId 为普通 UUID 记录（非 FK，归档语义）—— 后续候选被编辑/拒绝不影响
// 已冻结集合；历史集合语义永不漂移。
model CompetitorSetEntry {
  id            String @id @default(uuid()) @db.Uuid
  competitorSetId String @db.Uuid
  candidateId    String @db.Uuid // 溯源：对应 CompetitorCandidate.id（非 FK）
  canonicalName  String
  aliases        String[]
  competitorType CompetitorType
  sortOrder      Int

  competitorSet CompetitorSet @relation(fields: [competitorSetId], references: [id], onDelete: Cascade)

  @@unique([competitorSetId, sortOrder])
  @@unique([competitorSetId, candidateId])
  @@index([competitorSetId])
}

// ============================================================
// M7A - GEO Diagnosis（可行动的问题诊断，绑定 Report 快照）
// ============================================================
// 设计原则（M7A）：
//   1) Diagnosis 绑定 BenchmarkReport（而非项目实时数据）—— Report 已 snapshot
//      suiteName/Version、provider、requested/responseModel、metricSource、
//      analysisVersion、Competitor Set 版本与 metricsSnapshot；Diagnosis 基于该
//      快照生成，历史语义永不因后续编辑（Query/Set/Analysis v2）漂移。
//   2) 诊断规则为确定性启发式（geolens-diagnosis-v1），阈值属 GeoLens internal
//      heuristic（docs/m7-diagnosis.md 有 disclaimer），绝非行业标准或 LLM 推断。
//   3) DiagnosisFinding 只引用/归档证据链接（evidenceId/runId/queryText 快照），
//      绝不复制 rawPrompt/rawResponse —— Evidence 仍是唯一事实源且不可变。
//   4) findingType 用 String 而非枚举：便于未来 diagnosisVersion 演进扩展类型
//      （与 analysisVersion String 同风格）；severity 用固定枚举（HIGH/MEDIUM/LOW/INFO）。
//   5) 幂等：同一 (reportId, diagnosisVersion, secondaryReportId) 视为同一输入，
//      重复生成返回既有 DiagnosisRun（不无限堆快照）。

enum DiagnosisSeverity {
  HIGH
  MEDIUM
  LOW
  INFO
}

model DiagnosisRun {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  reportId          String   @db.Uuid // 归档引用：Report 已冻结自身 provenance（不级联删除）
  diagnosisVersion  String   // 规则版本：geolens-diagnosis-v1
  secondaryReportId String?  @db.Uuid // Provider Gap 对比的第二份报告（归档引用，可空）
  status            String   @default("READY") // READY = 生成完成（原子）；异常不落半成品
  // 摘要快照：severity 计数 + 代表性问题/竞品/模型差异/数据质量（随 DiagnosisRun 冻结）
  summarySnapshot   Json?
  metadata          Json     @default("{}")
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings DiagnosisFinding[]
  recommendationRuns RecommendationRun[]

  @@index([projectId, generatedAt])
  @@index([reportId, generatedAt])
  // 幂等键（service 层以 null 等价处理 secondaryReportId）
  @@index([reportId, diagnosisVersion, secondaryReportId])
}

model DiagnosisFinding {
  id              String           @id @default(uuid()) @db.Uuid
  diagnosisRunId  String           @db.Uuid
  findingType     String           // LOW_VISIBILITY / CATEGORY_GAP / …（版本演进可扩展）
  severity        DiagnosisSeverity
  category        String?          // canonical category（UI 显示中文）
  title           String
  summary         String           // 事实摘要（含数字）
  explanation     String           // 规则解释 + internal heuristic 说明
  metricName      String?
  currentValue    Float?
  referenceValue  Float?
  queryCount      Int              @default(0) // 受影响测试问题数
  evidenceCount   Int              @default(0)
  provider        String?          // 涉及 Provider（PROVIDER_GAP 等）
  requestedModel  String?
  responseModel   String?
  competitorName  String?          // 涉及竞品 canonicalName
  priorityScore   Int              // 0–100 确定性内部优先级
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())

  diagnosisRun DiagnosisRun             @relation(fields: [diagnosisRunId], references: [id], onDelete: Cascade)
  evidenceLinks DiagnosisFindingEvidence[]

  @@index([diagnosisRunId, severity])
  @@index([diagnosisRunId, findingType])
}

// Finding → Evidence 归档链接（evidenceId/runId 普通 UUID，非 FK —— 只引用不拥有；
// Evidence 删除不影响历史诊断的解释，读取路径以快照 queryText 为准）。
model DiagnosisFindingEvidence {
  id               String @id @default(uuid()) @db.Uuid
  findingId        String @db.Uuid
  evidenceId       String @db.Uuid
  runId            String @db.Uuid
  queryTextSnapshot String // 生成时冻结的问题文本（溯源展示）
  reason           String // 该 Evidence 为何支持此 Finding
  createdAt        DateTime @default(now())

  finding DiagnosisFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([evidenceId])
}

// ============================================================
// M7B - Optimization Recommendations（Diagnosis-backed 优化建议）
// ============================================================
// 设计原则（M7B）：
//   1) Recommendation 是「优化假设 / 行动建议」（hypothesis-backed action），
//      不是事实、不是因果证明、不是效果承诺 —— UI 恒带免责声明。
//   2) 必须 Diagnosis-backed：每个 RecommendationRun 绑定一个 DiagnosisRun；
//      Recommendation→RecommendationFinding→DiagnosisFinding→FindingEvidence
//      →Evidence 全链可回查。无对应 Finding 绝不凭空生成。
//   3) 确定性引擎（geo-core recommendations.ts）：Finding→Strategy 映射 +
//      clustering/dedup + priority + effort/expectedSignal/action 均由规则产生；
//      不引入 LLM。recommendationType/actionType/targetAssetType/status 用
//      String（与 findingType 同风格，便于版本演进），集中常量 + UI 中文映射。
//   4) Snapshot：生成即冻结；同 (diagnosisRunId, recommendationVersion)
//      幂等返回既有 RecommendationRun；后续规则/诊断变化不改变历史。
//   5) 人工 review 状态（PROPOSED/ACCEPTED/DISMISSED）与 ActionItem
//      （TODO/IN_PROGRESS/DONE/SKIPPED）只做轻量记录，M7D 再升级实验生命周期。
//   6) 绝不复制 Evidence.rawResponse / 完整 Finding —— 只通过关联回链。

model RecommendationRun {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @db.Uuid
  diagnosisRunId        String   @db.Uuid
  recommendationVersion String   // geolens-recommendation-v1
  status                String   @default("READY")
  summarySnapshot       Json?    // 优先级计数 + 主要优化方向等（随 Run 冻结）
  metadata              Json     @default("{}")
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diagnosisRun   DiagnosisRun       @relation(fields: [diagnosisRunId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  contentOpportunityRuns ContentOpportunityRun[]

  @@index([projectId, generatedAt])
  @@index([diagnosisRunId, generatedAt])
  @@index([diagnosisRunId, recommendationVersion])
}

model Recommendation {
  id                   String   @id @default(uuid()) @db.Uuid
  recommendationRunId  String   @db.Uuid
  recommendationType   String   // ENTITY_CLARITY / CATEGORY_COVERAGE / …
  title                String
  summary              String
  rationale            String   // 为什么出现这条建议（含来源诊断事实，非「AI 建议」）
  priority             String   // HIGH / MEDIUM / LOW（人工 review 用；与 diagnosis severity 语义不同）
  priorityScore        Int      // 0–100 确定性内部评分
  impactArea           String   // ENTITY / POSITIONING / CONTENT_COVERAGE / …（策略分类）
  targetAssetType      String?  // 建议可能涉及的资产类型（HOMEPAGE / USE_CASE_PAGE / …）
  expectedSignal       String?  // 希望改善的 GEO signal（不是 expectedDelta / 不承诺提升）
  effortLevel          String?  // LOW / MEDIUM / HIGH（粗粒度估计，不假装精确工时）
  status               String   @default("PROPOSED") // PROPOSED / ACCEPTED / DISMISSED
  findingCount         Int      @default(0)
  evidenceCount        Int      @default(0)
  category             String?  // 关联场景 canonical（clustering key 之一）
  competitorName       String?  // 关联竞品（competitor differentiation 分离用）
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recommendationRun RecommendationRun   @relation(fields: [recommendationRunId], references: [id], onDelete: Cascade)
  findings           RecommendationFinding[]
  actionItems        ActionItem[]
  opportunityLinks   ContentOpportunityRecommendation[]

  @@index([recommendationRunId, priorityScore])
  @@index([recommendationRunId, status])
}

model RecommendationFinding {
  id               String @id @default(uuid()) @db.Uuid
  recommendationId String @db.Uuid
  findingId        String @db.Uuid // 归档引用：DiagnosisFinding.id（不复制 Finding 内容）
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, findingId])
  @@index([findingId])
}

model ActionItem {
  id                 String   @id @default(uuid()) @db.Uuid
  recommendationId   String   @db.Uuid
  actionType         String   // UPDATE_PRODUCT_DEFINITION / CLARIFY_CORE_USE_CASES / …
  title              String
  description        String
  sortOrder          Int
  effortLevel        String   @default("LOW") // LOW / MEDIUM / HIGH（粗粒度）
  verificationMethod String?  // 完成后如何验证（M7D 复测基础；本轮不执行复测）
  status             String   @default("TODO") // TODO / IN_PROGRESS / DONE / SKIPPED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId, sortOrder])
}

// ============================================================
// M7C - Content Opportunities（内容机会 / 内容任务 brief foundation）
// ============================================================
// 设计原则（M7C）：
//   1) ContentOpportunityRun 绑定 RecommendationRun（快照 provenance 最清晰）：
//      一个 Run 冻结一批内容机会；Opportunity 通过
//      ContentOpportunityRecommendation 关联一个或多个来源 Recommendation。
//   2) ContentOpportunity = 内容机会 / 任务 brief，不是最终稿：titleDirection（标题方向）、
//      suggested blocks（建议结构块 title+purpose）绝不携带完整正文/营销标题。
//   3) Query 来源 = Recommendation→RecommendationFinding→DiagnosisFinding→
//      DiagnosisFindingEvidence.queryTextSnapshot（归档快照），不实时 join 当前
//      Project Query —— 历史语义不漂移。category/intent/locale 在生成时从来源
//      BenchmarkRunQuery 快照对齐补全，取不到则为 null（不猜测）。
//   4) Target Engines / Competitors 冻结在 Opportunity 的 Json snapshot：
//      engines 来自真实 Evidence provenance（provider/engineKey/engineName/
//      requestedModel/responseModel），competitors 只允许「已审核竞品语义」
//      （来自来源报告 Competitor Set 的 approved canonicalName）——绝不把
//      DISCOVERED 未审核 Candidate 当作正式目标竞品。
//   5) Status 只做人工作业状态（PROPOSED/APPROVED/DISMISSED），无 EXECUTING/
//      COMPLETED —— 执行与复测属 M7D。expectedSignals 只是「后续重点观察的信号」，
//      不是 expectedDelta（不承诺提升）。
//   6) opportunityType / contentIntent / priority / effort / status 用 String
//      （版本演进友好，同 M7B），版本集中常量 geolens-content-opportunity-v1。
//      幂等：同 (recommendationRunId, opportunityVersion) 重复生成返回既有 Run。
//   7) Evidence 只做指向性引用（evidenceId/runId/queryTextSnapshot 快照），
//      绝不复制 Evidence.rawResponse —— Evidence 仍是唯一事实源且不可变。
model ContentOpportunityRun {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @db.Uuid
  recommendationRunId   String   @db.Uuid
  opportunityVersion    String   // geolens-content-opportunity-v1
  status                String   @default("READY")
  summarySnapshot       Json?    // 内容机会计数 + 数据质量标记等（随 Run 冻结）
  metadata              Json     @default("{}")
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recommendationRun   RecommendationRun   @relation(fields: [recommendationRunId], references: [id], onDelete: Cascade)
  opportunities       ContentOpportunity[]

  @@index([projectId, generatedAt])
  @@index([recommendationRunId, generatedAt])
  @@index([recommendationRunId, opportunityVersion])
}

model ContentOpportunity {
  id                    String   @id @default(uuid()) @db.Uuid
  opportunityRunId      String   @db.Uuid
  opportunityType       String   // ENTITY_OVERVIEW / PRODUCT_PAGE / USE_CASE_PAGE / COMPARISON_PAGE / …
  titleDirection        String   // 标题方向（非最终发布标题）
  summary               String
  rationale             String   // 为什么生成（来源建议/诊断/Query/竞品信号事实）
  priority              String   // HIGH / MEDIUM / LOW（人工 review）
  priorityScore         Int      // 0–100 确定性内部评分
  category              String?  // 关联场景 canonical（clustering key 之一）
  assetType             String?  // 建议资产类型（= opportunityType；备选存 metadata）
  contentIntent         String   // DISCOVERY / RECOMMENDATION / COMPARISON / HOW_TO / …
  effortLevel           String   // LOW / MEDIUM / HIGH（粗粒度 internal heuristic）
  expectedSignals       String[] // 建议后续观察的信号（≠ expectedDelta，不承诺提升）
  representativeQuery   String?  // 用于 UI 摘要的代表性问题（确定性选择，非随机）
  targetQueryCount      Int      @default(0)
  targetEngineCount     Int      @default(0)
  targetCompetitorCount Int      @default(0)
  evidenceCount         Int      @default(0)
  recommendationCount   Int      @default(0)
  status                String   @default("PROPOSED") // PROPOSED / APPROVED / DISMISSED（仅人工）
  dataQualityLimited    Boolean  @default(false) // 该机会是否被数据质量 guard 降级
  // ---- 冻结的目标引擎 / 竞品快照（Json，来源可审计；引擎见 Evidence provenance，
  //      竞品仅 approved semantics）----
  targetEngines         Json     @default("{}")     // { items: [{provider, engineKey, engineName, requestedModel, responseModel}] }
  targetCompetitors     Json     @default("{}")     // { items: [{canonicalName, competitorType}] }
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  opportunityRun ContentOpportunityRun @relation(fields: [opportunityRunId], references: [id], onDelete: Cascade)
  recommendations ContentOpportunityRecommendation[]
  queries          ContentOpportunityQuery[]
  evidenceLinks    ContentOpportunityEvidence[]
  blocks           ContentOpportunityBlock[]
  experiments      OptimizationExperiment[]
  assetMappings    OpportunityAssetMapping[]
  changePlans      OptimizationChangePlan[]

  @@index([opportunityRunId, priorityScore])
  @@index([opportunityRunId, status])
  @@index([opportunityRunId, opportunityType])
}

// Opportunity → 来源 Recommendation 关联（必须可回溯；保留全部 source links）。
model ContentOpportunityRecommendation {
  id               String @id @default(uuid()) @db.Uuid
  opportunityId    String @db.Uuid
  recommendationId String @db.Uuid
  createdAt        DateTime @default(now())

  opportunity     ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendation  Recommendation     @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, recommendationId])
  @@index([recommendationId])
}

// 目标 Query 快照行（queryTextSnapshot 来自 DiagnosisFindingEvidence；category/intent/
// locale 来自 BenchmarkRunQuery 快照对齐；brandAbsent/competitorPositive/engines 为
// 生成时从 Evidence/Analysis 聚合的只读事实 —— UI「为什么」表格展示，全部非实时）。
model ContentOpportunityQuery {
  id                  String   @id @default(uuid()) @db.Uuid
  opportunityId       String   @db.Uuid
  queryTextSnapshot   String
  category            String?
  intent              String?
  locale              String?
  brandAbsent         Boolean? // 该问题回答中品牌是否缺席（true=缺席；null=无法判定）
  competitorPositive  Boolean? // 该问题是否出现已审核竞品正面/推荐信号
  sourceEvidenceCount Int      @default(0) // 该 Query 在机会内关联的证据链接数
  sortOrder           Int
  metadata            Json     @default("{}") // 含 engines:[…]（该 query 涉及的目标引擎快照）
  createdAt           DateTime @default(now())

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, sortOrder])
}

// Opportunity → Evidence 指向性链接（evidenceId/runId 普通 UUID，非 FK —— 只引用不拥有；
// Evidence 删除不影响历史机会的解释；点击后经 runId 打开现有 Evidence Dialog）。
model ContentOpportunityEvidence {
  id               String   @id @default(uuid()) @db.Uuid
  opportunityId    String   @db.Uuid
  evidenceId       String   @db.Uuid
  runId            String   @db.Uuid
  queryTextSnapshot String
  reason           String   // 该 Evidence 为何支撑此机会（来自来源 Finding 的 reason）
  createdAt        DateTime @default(now())

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, evidenceId])
  @@index([evidenceId])
  @@index([runId])
}

// 建议内容结构块（仅 title + purpose，禁止存完整正文）。
model ContentOpportunityBlock {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @db.Uuid
  blockType     String   // USER_SCENARIO / CORE_TASKS / COMPARISON_DIMENSIONS / FAQ / …
  title         String
  purpose       String
  sortOrder     Int
  createdAt     DateTime @default(now())

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, sortOrder])
}

// ============================================================
// M7D - Optimization Experiment & Re-test（受控复测基础）
// ============================================================
// 设计原则（M7D）：
//   1) OptimizationExperiment 绑定一个 ContentOpportunity 及其 Baseline Report：
//      Before / Execution / Retest / Evaluation 四层语义分开，绝不覆盖。
//   2) Frozen Re-test：After 必须复用 Baseline BenchmarkRunQuery 快照
//      （queryText/category/intent/locale/weight/sanity/sortOrder），绝不静默读取
//      后来编辑过的当前 BenchmarkQuery —— 通过 benchmark 层 startRunFromSnapshot
//      与 querySetFingerprint（SHA-256 of ordered semantic rows）保证同口径。
//   3) Evaluation 生成即 immutable snapshot（geolens-experiment-evaluation-v1）；
//      未来 v2 通过新版本并存，不重算旧记录。Retest 支持多次（#1/#2/#3…）。
//   4) Demo/Real isolation：metricSource 继承来源；Demo 只能绑 Demo，Real 只能绑 Real；
//      Demo 报告永不进入 Real 结论。Real Re-test 必须走既有 Real Provider Guard
//      （planned call count ≤ REAL_PROVIDER_MAX_RUNS_PER_TASK）。
//   5) 状态仅人工推进：PLANNED → EXECUTION_RECORDED → RETEST_READY → RETEST_RUNNING
//      → READY_FOR_EVALUATION → EVALUATED（或 CANCELLED）。不自动“执行完成”。
//   6) Execution 只做用户确认的变更记录（绝不自动修改/验证外部页面；assetReference
//      仅记录 URL/页面标识，本系统不 fetch）。
//   7) Evidence/BenchmarkRun/Report 一律不可变：本层只存 before/after 的 evidenceId/
//      reportId 指向性引用，绝不复制 rawResponse。

model OptimizationExperiment {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @db.Uuid
  contentOpportunityId  String   @db.Uuid
  experimentVersion     String   // geolens-experiment-v1
  title                 String
  hypothesis            String   // 确定性模板（“可能改善”，非“一定提升”）
  status                String   @default("PLANNED") // PLANNED/EXECUTION_RECORDED/RETEST_READY/RETEST_RUNNING/READY_FOR_EVALUATION/EVALUATED/CANCELLED
  // ---- Baseline provenance 快照（来自 ContentOpportunity 来源 Report；普通 uuid 归档，非 FK）----
  baselineReportId      String   @db.Uuid
  querySetFingerprint   String   // 基线测试集指纹（SHA-256，语义行有序序列化）
  metricSource          String   // demo | real | mixed（继承基线；Demo/Real 隔离）
  // ---- M8A Measurement Validity（基线测量有效性快照：创建时从 baseline evidence 冻结）----
  measurementValidity   String?  // VALID_FOR_WEB_CHANGE / PARTIALLY_VALID / INVALID_FOR_WEB_CHANGE / UNKNOWN
  measurementMode       String?  // WEB_VALIDATED / MANUAL_VERIFIED / MODEL_BEHAVIOR_ONLY / UNKNOWN
  measurementWarnings   Json?    // reasons[]（为什么该基线不能直接支撑网页变化结论）
  provider              String
  engineId              String?  @db.Uuid
  engineKey             String?
  engineName            String?
  requestedModel        String?
  responseModel         String?
  analysisVersion       String
  competitorSetVersion  String?
  suiteName             String?
  suiteVersion          String?
  plannedQueryCount     Int      @default(0)
  executionRecordedAt   DateTime?
  completedAt           DateTime?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentOpportunity ContentOpportunity  @relation(fields: [contentOpportunityId], references: [id], onDelete: Restrict)
  executions       ExperimentExecution[]
  retests          ExperimentRetest[]
  evaluations      ExperimentEvaluation[]
  pilotReviews     PilotReview[]

  @@index([projectId, createdAt])
  @@index([contentOpportunityId, createdAt])
  @@index([baselineReportId])
  @@index([status])
}

model ExperimentExecution {
  id             String   @id @default(uuid()) @db.Uuid
  experimentId   String   @db.Uuid
  executionType  String   // MANUAL_CONTENT_UPDATE / MANUAL_PAGE_CREATE / MANUAL_FAQ_UPDATE / MANUAL_DOCUMENTATION_UPDATE / MANUAL_OTHER
  changeSummary  String   // 用户确认的变更摘要
  assetType      String?  // 优化对象（assetType canonical）
  assetReference String?  // 用户记录的 URL / 页面标识（系统不 fetch / 不验证）
  executedAt     DateTime // 用户声明的执行时间（必须 >= baseline report.generatedAt）
  status         String   @default("RECORDED") // RECORDED / REVOKED
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  experiment OptimizationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, executedAt])
}

model ExperimentRetest {
  id                String   @id @default(uuid()) @db.Uuid
  experimentId      String   @db.Uuid
  sequence          Int      // #1/#2/#3…（多次复测不覆盖旧记录）
  // ---- 复测 run / 报告（普通 uuid 归档；run 完成后回填）----
  benchmarkRunId    String?  @db.Uuid
  reportId          String?  @db.Uuid
  status            String   @default("QUEUED") // QUEUED / RUNNING / SUCCEEDED / FAILED / PARTIAL / CANCELLED
  runType           String   // DEMO / REAL
  provider          String
  engineId          String?  @db.Uuid
  engineKey         String?
  requestedModel    String?
  plannedQueryCount Int
  expectedCallCount Int      // planned queries × provider（成本 guard 用）
  querySetFingerprint String // 复测冻结集指纹（须与基线一致）
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())

  experiment OptimizationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, sequence])
  @@index([experimentId, status])
}

model ExperimentEvaluation {
  id                String   @id @default(uuid()) @db.Uuid
  experimentId      String   @db.Uuid
  retestId          String   @db.Uuid // 普通 uuid 归档
  evaluationVersion String   // geolens-experiment-evaluation-v1（未来 v2 并存，不重算 v1）
  beforeReportId    String   @db.Uuid
  afterReportId     String   @db.Uuid
  // ---- 结论快照（immutable）----
  outcome           String   // IMPROVED_SIGNALS / MIXED_SIGNALS / NO_CLEAR_CHANGE / REGRESSED_SIGNALS / INCONCLUSIVE
  compatibility     Json     @default("{}") // { verdict, dimensions[], warnings[] }
  summarySnapshot   Json     @default("{}") // 指标汇总 / 状态数等（随 Evaluation 冻结）
  metricSource      String   // before/after 一致才可 EVALUATED（否则 NOT_COMPARABLE）
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  experiment OptimizationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  metricDeltas ExperimentMetricDelta[]
  queryDeltas  ExperimentQueryDelta[]

  @@index([experimentId, generatedAt])
  @@index([retestId, evaluationVersion])
}

model ExperimentMetricDelta {
  id            String  @id @default(uuid()) @db.Uuid
  evaluationId  String  @db.Uuid
  metricName    String  // visibilityRate / recommendationRate / averageMentionPosition / shareOfVoice / citationCount / citationDomainCount
  beforeValue   Float?
  afterValue    Float?
  deltaValue    Float?  // after - before（位置类 delta raw 可能为负但 UI 显示“提升 N 位”）
  deltaUnit     String  // pp / position / count（严禁用相对 %）
  direction     String? // IMPROVED / DECLINED / NEUTRAL（按 metric 方向定义）
  meaningful    String  // MEANINGFUL / SMALL / NEUTRAL（internal heuristic）
  primarySignal Boolean @default(false) // 是否属于该机会 expectedSignals 主信号
  createdAt     DateTime @default(now())

  evaluation ExperimentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model ExperimentQueryDelta {
  id                String   @id @default(uuid()) @db.Uuid
  evaluationId      String   @db.Uuid
  sortOrder         Int
  queryTextSnapshot String
  category          String?
  beforeEvidenceId  String?  @db.Uuid // 指向性引用（Evidence immutable，不复制 rawResponse）
  afterEvidenceId   String?  @db.Uuid
  beforeMentioned   Boolean?
  afterMentioned    Boolean?
  beforeRecommended Boolean?
  afterRecommended  Boolean?
  beforePosition    Int?
  afterPosition     Int?
  beforeCitationCount Int    @default(-1) // -1 = 无可用数据
  afterCitationCount  Int    @default(-1)
  transitionType    String   // GAINED_VISIBILITY / LOST_VISIBILITY / … / NOT_EVALUABLE（failed run ≠ brand missing）
  status            String   @default("EVALUATED") // EVALUATED / NOT_EVALUABLE
  createdAt         DateTime @default(now())

  evaluation ExperimentEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId, sortOrder])
}

// ============================================================
// M8 - Real Optimization Pilot（真实站点资产 / 变更计划 / 试点 / 学习）
// ============================================================
// 设计原则（M8）：
//   1) M8A Measurement Validity：普通模型 API（api_plain）≠ Web Search/Retrieval，
//      不能把“改了公开网页”与“api_plain 输出变化”直接当网页 GEO 实验结论。
//      判定只依据 Evidence.retrievalMode/sourceType（不按 provider 名猜），
//      快照冻结在 OptimizationExperiment.measurement*。
//   2) M8B Site Asset：解决 M7C“无 website inventory”limitation。清单来源分
//      MANUAL/SITEMAP/CRAWLER/IMPORTED；本轮若无 crawler 不假装有（优先 manual+sitemap）。
//      抓取一律 GET-only、同站点域名白名单、禁内网/metadata/file/redirect 跳私网；
//      snapshot 只存可审计文本/标题/hash，不存页面二进制。
//   3) Opportunity→Asset 映射必须是 UPDATE_EXISTING / CREATE_NEW / UNKNOWN 且人工确认：
//      系统不因“没有匹配资产”就自动声称“必须新建页面”。
//   4) Change Plan 是编辑说明（section/type/instruction/reason），不是最终正文
//      （无 finalPublishedText），不自动发布（DRAFT/APPROVED/EXECUTED_MANUALLY/CANCELLED）。
//   5) M8C Pilot Review 是观察结果快照（reviewVersion 独立并存），outcome 允许
//      IMPROVED/MIXED/NO_CLEAR_CHANGE/REGRESSED/INCONCLUSIVE/INVALID_MEASUREMENT/
//      CHANGE_NOT_VERIFIED —— 绝不伪造提升；attributionConfidence 只有 LOW/MEDIUM。
//   6) 真实授权（Real Provider Calls / External Site Write / Publication）不在 DB
//      表达，一律走 env + 用户逐次批准；本层只记录真实发生的事实（execution record、
//      after snapshot、review），0 成本 Demo 永不伪装真实 Pilot。

// 站点（一个项目可有多个：官网/帮助中心…）
model Site {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name      String
  baseUrl   String   // 同源校验白名单根（http(s)://host）
  status    String   @default("ACTIVE") // ACTIVE / ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  SiteAsset[]

  @@index([projectId, status])
}

// 站点资产（页面/资源）：M8B inventory 单页单位。
model SiteAsset {
  id             String   @id @default(uuid()) @db.Uuid
  siteId         String   @db.Uuid
  url            String   // 观测到的 URL（可能带 query/hash）
  canonicalUrl   String   // 去重用的 canonical（去 fragment、尾斜杠归一）
  assetType      String?  // PRODUCT_PAGE / USE_CASE_PAGE / …（同 M7C assetType 语义；可空=未知）
  title          String?
  status         String   @default("KNOWN") // KNOWN / REMOVED / UNKNOWN
  source         String   @default("MANUAL") // MANUAL / SITEMAP / CRAWLER / IMPORTED
  lastObservedAt DateTime?
  contentHash    String?  // 最近一次观察的文本 hash（sha256 of normalized text/title）
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  snapshots    SiteAssetSnapshot[]
  assetMappings OpportunityAssetMapping[]
  changePlans  OptimizationChangePlan[]

  @@index([siteId, status])
  @@unique([siteId, canonicalUrl])
}

// 资产快照：记录“网页改了什么”（title/text/hash），可审计变更。
// snapshotType: BEFORE_CHANGE / AFTER_CHANGE / OBSERVED / MANUAL_IMPORT
model SiteAssetSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  assetId      String   @db.Uuid
  snapshotType String   @default("OBSERVED")
  capturedAt   DateTime @default(now())
  contentHash  String   // sha256（title+extracted text 的规范化串）
  title        String?
  textSnapshot String?  // 安全抽取文本（长度受限，绝不含完整 HTML/二进制）
  textLength   Int?
  headings     Json     @default("{}") // { items: [heading text…] }（可选，非正文）
  source       String   @default("MANUAL") // MANUAL / SITEMAP / CRAWLER / IMPORTED
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  asset SiteAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, capturedAt])
}

// Opportunity → 站点资产映射（人工确认）。mappingType: UPDATE_EXISTING / CREATE_NEW / UNKNOWN
model OpportunityAssetMapping {
  id                   String   @id @default(uuid()) @db.Uuid
  contentOpportunityId String   @db.Uuid
  siteAssetId          String?  @db.Uuid // CREATE_NEW 时可为空（尚未有资产）
  mappingType          String   // UPDATE_EXISTING / CREATE_NEW / UNKNOWN
  confirmedByUser      Boolean  @default(false)
  note                 String?
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contentOpportunity ContentOpportunity @relation(fields: [contentOpportunityId], references: [id], onDelete: Cascade)
  siteAsset          SiteAsset?         @relation(fields: [siteAssetId], references: [id], onDelete: SetNull)

  @@index([contentOpportunityId])
  @@index([siteAssetId])
}

// 变更计划：把 M7C 建议结构转成“编辑说明”（不是正文、不自动发布）。
model OptimizationChangePlan {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  contentOpportunityId String   @db.Uuid
  siteAssetId          String?  @db.Uuid
  changePlanVersion    String   // geolens-change-plan-v1
  title                String
  summary              String
  status               String   @default("DRAFT") // DRAFT / APPROVED / EXECUTED_MANUALLY / CANCELLED
  approvedAt           DateTime?
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentOpportunity ContentOpportunity @relation(fields: [contentOpportunityId], references: [id], onDelete: Restrict)
  siteAsset          SiteAsset?         @relation(fields: [siteAssetId], references: [id], onDelete: SetNull)
  items              OptimizationChangeItem[]

  @@index([projectId, createdAt])
  @@index([contentOpportunityId])
  @@index([siteAssetId])
}

model OptimizationChangeItem {
  id                      String   @id @default(uuid()) @db.Uuid
  changePlanId            String   @db.Uuid
  section                 String   // 建议结构块/页面区域（来自 Opportunity Block title 等）
  changeType              String   // ADD_SECTION / UPDATE_SECTION / CLARIFY_ENTITY / ADD_USE_CASE / ADD_FAQ / ADD_COMPARISON_INFO / ADD_VERIFIABLE_FACT / ADD_SOURCE_REFERENCE / UPDATE_TITLE / UPDATE_METADATA / OTHER
  instruction             String   // 具体编辑指令（≤ 若干句；不是最终全文）
  reason                  String   // 为什么改（回链 opportunity rationale / block purpose）
  sourceRecommendationId  String?  @db.Uuid // 普通 uuid 归档（非 FK）：可回溯 M7B Recommendation
  sourceFindingId         String?  @db.Uuid // 普通 uuid 归档（非 FK）：可回溯 M7A DiagnosisFinding
  sortOrder               Int      @default(0)
  status                  String   @default("PENDING") // PENDING / DONE / SKIPPED（人工勾选）
  metadata                Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  changePlan OptimizationChangePlan @relation(fields: [changePlanId], references: [id], onDelete: Cascade)

  @@index([changePlanId, sortOrder])
}

// Pilot Review：M8C 完成后的一次性观察结果快照（immutable；reviewVersion 并存）。
model PilotReview {
  id                     String   @id @default(uuid()) @db.Uuid
  experimentId           String   @db.Uuid
  reviewVersion          String   // geolens-pilot-review-v1
  measurementValidity    String   // 判定快照：VALID_FOR_WEB_CHANGE / PARTIALLY_VALID / INVALID_FOR_WEB_CHANGE / UNKNOWN
  measurementMode        String?  // WEB_VALIDATED / MANUAL_VERIFIED / MODEL_BEHAVIOR_ONLY / UNKNOWN
  executionValidity      String   // CHANGE_VERIFIED / CHANGE_NOT_OBSERVED / NOT_RECORDED
  comparisonValidity     String   // CONTROLLED_COMPARABLE / PARTIALLY_COMPARABLE / NOT_COMPARABLE
  observedOutcome        String   // IMPROVED_SIGNALS / MIXED_SIGNALS / NO_CLEAR_CHANGE / REGRESSED_SIGNALS / INCONCLUSIVE / INVALID_MEASUREMENT / CHANGE_NOT_VERIFIED
  attributionConfidence  String   // LOW / MEDIUM（无 control/repeat/stable 之前不做 HIGH）
  changedAssetCited      Boolean?
  retrievalObservedForChangedAsset String? // TRUE / FALSE / UNKNOWN
  evaluationId           String?  @db.Uuid // 普通 uuid 归档（非 FK）：本 review 依据的 M7D Evaluation
  lessons                Json     @default("{}") // { items: [{ category, message }] }
  summarySnapshot        Json     @default("{}") // 指标/query delta 汇总随 review 冻结
  generatedAt            DateTime @default(now())
  createdAt              DateTime @default(now())

  experiment OptimizationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, generatedAt])
  @@index([experimentId, reviewVersion])
}

// ============================================================
// M8E - Target Entity Profile（通用监测对象）
// ============================================================
// 设计决定（M8E Gate A）：
//   - 1 Project = 1 Primary Target：监测对象 = project 的 primary Brand（worker
//     snapshotEntities 已取 brands[0] 为 brand entity；M8E 在其上补 entityType /
//     productCategory）。不新增第二套 target 主表 —— Brand 即 Target Profile 载体。
//   - TargetEntityAlias：提供按 alias 粒度的 aliasType + enabled 管理；历史 / 只读
//     兼容保留 Brand.aliases（快照式）。读取合并逻辑在服务层确定性完成。
model TargetEntityAlias {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @db.Uuid
  alias         String
  aliasType     String   @default("CUSTOM") // OFFICIAL / PRODUCT / ABBREVIATION / LOCALIZED / CUSTOM
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, alias])
  @@index([brandId, enabled])
}

// ============================================================
// M9 - 内容执行领域（Content Execution Domain）
// ============================================================
// 设计原则（PHASE 2-13 收口）：
//   1) 独立但可追溯：每一条内容数据都挂 organizationId + projectId，回溯到租户/项目。
//   2) 人工审批闸门：DRAFT 不会自动 APPROVED，也不会自动发布；只有「最新 revision 的
//      APPROVED 批准」才允许进入 Publication 流程（状态机强制）。
//   3) 渠道中立（Channel-neutral）：Publication 只承载渠道中立的 content payload；
//      XIAOHONGSHU / DOUYIN 等为 Channel 枚举值，预留 WEIBO/WECHAT/BAIDU/OTHER。
//   4) 凭证安全：ChannelAccountConnection 只存 credentialRef（指向密钥库），
//      绝不内联 token / secret；externalId / externalUrl 由 Mock Publisher 生成假值。
//   5) 出站写保护闸门：EXTERNAL_PUBLISHING_ENABLED=false（本轮回合恒为 false）；
//      任何真实平台发布调用 = 0，Mock Publisher 仅产生占位/假 id，不触达外部。
//   6) 度量边界：Publication / PublicationAttempt 与 GEO Evidence / OptimizationExperiment
//      解耦——发布成功与否不构成 GEO 优化证据，避免污染实验度量。
//   7) 生成溯源：generationMode 区分 MANUAL / AI_ASSISTED / AI_GENERATED；
//      不存储敏感 prompt / API key。
//   8) 幂等：Publication.idempotencyKey 与 PublicationAttempt.idempotencyKey 唯一，
//      保证重试/重放安全（Redis 仅承载标识符，数据落在 Postgres）。

enum GenerationMode {
  MANUAL
  AI_ASSISTED
  AI_GENERATED
}

enum DraftStatus {
  DRAFT
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum Channel {
  XIAOHONGSHU
  DOUYIN
  WEIBO
  WECHAT
  BAIDU
  OTHER
  WORDPRESS
  GHOST
  WEBFLOW
  BLOGGER
  DEV_TO
  MASTODON
  BLUESKY
  TELEGRAM
  DISCORD
  SLACK
  THREADS
  LINKEDIN
  PINTEREST
  X
  REDDIT
  GOOGLE_BUSINESS_PROFILE
  YOUTUBE
  BILIBILI
  WECHAT_OFFICIAL_ACCOUNT
  TOUTIAO
  XIGUA
  TIKTOK
  INSTAGRAM
  FACEBOOK
  BAIDU_SEARCH_SURFACE
  WECHAT_CHANNELS
  ZHIHU
  BAIJIAHAO
  KUAISHOU
  SUBSTACK
  MEDIUM
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
  REQUIRES_APP_REVIEW
  REQUIRES_SCOPE
  READY_FOR_CREDENTIALS
  REQUIRES_ENTERPRISE_QUALIFICATION
}

enum PublicationStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  DRAFT_CREATED_EXTERNALLY
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum AssetType {
  IMAGE
  VIDEO
  COVER
  AUDIO
  TEXT
  OTHER
}

enum ContentAuditAction {
  DRAFT_CREATED
  DRAFT_UPDATED
  REVISION_CREATED
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLICATION_CREATED
  PUBLICATION_QUEUED
  PUBLICATION_SUCCEEDED
  PUBLICATION_FAILED
  PUBLICATION_CANCELLED
}

enum ContentUsageEventType {
  CONTENT_GENERATION
  PUBLICATION_ATTEMPT
}

model ContentDraft {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  projectId      String         @db.Uuid
  title          String
  topic          String?
  generationMode GenerationMode @default(MANUAL)
  status         DraftStatus    @default(DRAFT)
  // 来源溯源（PHASE 2）：可空引用，仅存 id、不做 FK —— 跨 project/tenant 引用由服务层强制拒绝。
  // 不伪造关联：写入前校验来源实体存在且属于同一 project（同一租户）。
  sourceOpportunityId    String? @db.Uuid
  sourceRecommendationId String? @db.Uuid
  sourceDiagnosisId      String? @db.Uuid
  sourceStrategyId       String? @db.Uuid
  sourcePlanItemId       String? @db.Uuid
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions   ContentRevision[]
  approvals   ContentApproval[]
  assets      ContentAsset[]
  publications Publication[]
  auditLogs   ContentAuditLog[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
}

model ContentRevision {
  id           String   @id @default(uuid()) @db.Uuid
  draftId      String   @db.Uuid
  version      Int      @default(1)
  body         String   // 渠道中立的内容主体（序列化 JSON 或纯文本）
  summary      String?
  changeNote   String?
  generatedById String  @db.Uuid
  createdAt    DateTime @default(now())

  draft    ContentDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  approvals ContentApproval[]
  publications Publication[] // Publication.revision 的反向关系

  @@unique([draftId, version])
  @@index([draftId])
}

model ContentApproval {
  id         String           @id @default(uuid()) @db.Uuid
  draftId    String           @db.Uuid
  revisionId String           @db.Uuid
  decision   ApprovalDecision
  reviewerId String           @db.Uuid
  comment    String?
  createdAt  DateTime         @default(now())

  draft    ContentDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revision ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([revisionId])
}

model ContentAsset {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId    String   @db.Uuid
  draftId      String?  @db.Uuid
  type         AssetType @default(IMAGE)
  mimeType     String   // MIME allowlist 在应用层强制校验
  sizeBytes    Int
  checksum     String   // sha256，防止重复/篡改
  storageKey   String   // 不透明存储引用，不含任何密钥
  ownerId      String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft       ContentDraft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([draftId])
}

model ChannelAccountConnection {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  channel        Channel
  displayName    String
  // OAuth readiness：仅存 credentialRef（指向密钥库，如 vault://geo/oauth/<channel>/<id>），
  // 绝不内联 token / secret / refreshToken。
  credentialRef  String?
  status         ConnectionStatus @default(CONNECTED)
  lastVerifiedAt DateTime?
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([organizationId, channel, displayName])
  @@index([organizationId])
  @@index([status])
}

model Publication {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String           @db.Uuid
  draftId        String           @db.Uuid
  revisionId     String           @db.Uuid
  connectionId   String           @db.Uuid
  channel        Channel
  title          String?
  payload        String   // 渠道中立的序列化内容（JSON）
  status         PublicationStatus @default(PENDING)
  publishedAt    DateTime? // 成功发布时刻（PENDING/FAILED 为 null）
  idempotencyKey String   @unique // 安全重放 / 重试幂等键
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  draft       ContentDraft           @relation(fields: [draftId], references: [id], onDelete: Restrict)
  revision    ContentRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  connection  ChannelAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  attempts    PublicationAttempt[]
  auditLogs   ContentAuditLog[]

  @@index([organizationId])
  @@index([projectId])
  @@index([draftId])
  @@index([status])
}

model PublicationAttempt {
  id             String           @id @default(uuid()) @db.Uuid
  publicationId  String           @db.Uuid
  idempotencyKey String           @unique
  channel        Channel
  attemptNo      Int              @default(1)
  status         PublicationStatus @default(QUEUED) // PENDING/QUEUED/FAILED/PUBLISHED/CANCELLED
  publisher      String           @default("mock") // 本回合恒为 "mock"；绝不产生真实出站写
  externalId     String?  // Mock 生成的假 id（标记 fake，不触达外部）
  externalUrl    String?  // Mock 生成的假 url
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

model ContentAuditLog {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String?          @db.Uuid
  draftId        String?          @db.Uuid
  publicationId  String?          @db.Uuid
  action         ContentAuditAction
  actorId        String           @db.Uuid
  detail         String?  // 绝不记录 token / secret / 敏感 prompt
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft       ContentDraft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)
  publication Publication?   @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([draftId])
  @@index([publicationId])
  @@index([action])
}

// 用量/成本钩子（PHASE 16）：成本一律 null（无真实计费），绝不写 0（0 会误导为「零成本已计」）。
model ContentUsageEvent {
  id          String              @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  projectId   String?             @db.Uuid
  eventType   ContentUsageEventType
  provider    String              @default("none") // mock / none（本回合无真实 Provider 调用）
  costUsd     Float?              // 可空；默认 null（cost=null not 0）
  quantity    Int                 @default(1)
  actorId     String              @db.Uuid
  createdAt   DateTime            @default(now())

  @@index([organizationId])
  @@index([eventType])
}

// ============================================================
// M9A - 内容战略与内容计划（Content Strategy & Planning）
// ============================================================
model ContentStrategy {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  title                  String
  sourceOpportunityId    String?  @map("source_opportunity_id") @db.Uuid
  sourceRecommendationId String?  @map("source_recommendation_id") @db.Uuid
  sourceDiagnosisId      String?  @map("source_diagnosis_id") @db.Uuid
  status                 String   @default("ACTIVE") // ACTIVE / ARCHIVED
  geoGap                 String   @map("geo_gap")
  priorityQuestions      Json     @default("[]") @map("priority_questions")
  targetAudience         String   @map("target_audience")
  perceptionGoal         String   @map("perception_goal")
  keyThemes              Json     @default("[]") @map("key_themes")
  platformPriorities     Json     @default("[]") @map("platform_priorities")
  contentFormats         Json     @default("[]") @map("content_formats")
  evidenceRequired       Json     @default("[]") @map("evidence_required")
  validationMetrics      Json     @default("[]") @map("validation_metrics")
  metadata               Json     @default("{}")
  createdById            String   @map("created_by_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItems    ContentPlanItem[]
  campaigns    ContentCampaign[]

  @@map("content_strategies")
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

model ContentPlanItem {
  id                  String   @id @default(uuid()) @db.Uuid
  strategyId          String   @map("strategy_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  title               String
  platform            String
  format              String
  objective           String
  geoTarget           String   @map("geo_target")
  targetQueries       Json     @default("[]") @map("target_queries")
  keyClaims           Json     @default("[]") @map("key_claims")
  status              String   @default("PLANNED") // PLANNED / DRAFTED / COMPLETED / DISMISSED
  draftId             String?  @map("draft_id") @db.Uuid
  sourceOpportunityId String?  @map("source_opportunity_id") @db.Uuid
  sortOrder           Int      @default(0) @map("sort_order")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  strategy      ContentStrategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleItems ContentScheduleItem[]

  @@map("content_plan_items")
  @@index([strategyId])
  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([draftId])
}

// ============================================================
// M9B - 营销战役与内容排期（Campaign, Content Calendar & Production Queue）
// ============================================================
model ContentCampaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  name           String
  description    String?
  strategyId     String    @map("strategy_id") @db.Uuid
  objective      String
  primaryGeoGap  String    @map("primary_geo_gap")
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  status         String    @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  metadata       Json      @default("{}")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategy      ContentStrategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  scheduleItems ContentScheduleItem[]

  @@map("content_campaigns")
  @@index([organizationId])
  @@index([projectId])
  @@index([strategyId])
  @@index([status])
}

model ContentScheduleItem {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  campaignId       String    @map("campaign_id") @db.Uuid
  planItemId       String    @map("plan_item_id") @db.Uuid
  scheduledDate    DateTime  @map("scheduled_date")
  scheduledTime    String?   @map("scheduled_time")
  timezone         String    @default("Asia/Shanghai")
  productionStatus String    @default("PLANNED") @map("production_status") // PLANNED, BLOCKED_FACTS, BLOCKED_ASSETS, READY, IN_PROGRESS, DRAFT_CREATED, IN_REVIEW, APPROVED, READY_TO_PUBLISH, DONE
  blockReason      String?   @map("block_reason") // MISSING_REQUIRED_FACTS, MISSING_VIDEO_ASSET, MISSING_IMAGE_ASSET, DRAFT_NOT_CREATED, REVIEW_REQUIRED, APPROVAL_REJECTED
  assignedToId     String?   @map("assigned_to_id") @db.Uuid
  dependsOnItemId  String?   @map("depends_on_item_id") @db.Uuid
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign     ContentCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  planItem     ContentPlanItem      @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  dependsOn    ContentScheduleItem? @relation("ScheduleDependencies", fields: [dependsOnItemId], references: [id], onDelete: SetNull)
  dependents   ContentScheduleItem[] @relation("ScheduleDependencies")

  @@map("content_schedule_items")
  @@index([organizationId])
  @@index([projectId])
  @@index([campaignId])
  @@index([planItemId])
  @@index([scheduledDate])
  @@index([productionStatus])
}

